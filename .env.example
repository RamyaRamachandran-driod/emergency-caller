APP_MODE=test
ORCHESTRATOR_PORT=4100
DATABASE_PATH=./data/orchestrator.sqlite
DISCOVERY_PORT=4101
VOICE_PORT=4102
DISCOVERY_URL=http://localhost:4101
DISCOVERY_TIMEOUT_MS=180000
FOUND_STAGE_HOLD_MS=5000
VOICE_URL=http://localhost:4102
VOICE_REQUEST_TIMEOUT_MS=15000
ORCHESTRATOR_URL=http://localhost:4100
INTERNAL_SERVICE_TOKEN=replace-with-a-local-development-token
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REALTIME_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_VOICE_URL=
# Independently enable live voice while discovery and orchestrator stay simulated.
VOICE_MODE=test
VOICE_PROVIDER_PORT=4103
# Only these exact E.164 numbers may be dialed. Start with your own verified phone.
# allowlist for personal tests; sourced enables authenticated calls to published discovery numbers.
VOICE_DESTINATION_POLICY=allowlist
VOICE_ALLOWED_NUMBERS=
VOICE_MAX_SECONDS=180
VOICE_MAX_CONCURRENT=3
VOICE_DATA_DIR=data/voice
OPENAI_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Voice provider: twilio or vonage. The Vonage test caller ID needs a trial account.
VOICE_PROVIDER=vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=.secrets/vonage-private.key
VONAGE_FROM_NUMBER=123456789
