{
  "name": "emergency-caller",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n orchestrator,discovery,voice,dashboard \"npm run dev -w @emergency/orchestrator\" \"npm run dev -w @emergency/discovery\" \"npm run dev -w @emergency/voice\" \"npm run dev -w @emergency/dashboard\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build -w @emergency/dashboard",
    "test:kane": "node scripts/run-kane.mjs",
    "voice:dev": "npm run dev -w @emergency/voice",
    "voice:call": "node scripts/voice-call.mjs",
    "voice:tunnel": "node scripts/voice-tunnel.mjs",
    "test:voice": "tsx --test services/voice/test/*.test.ts",
    "voice:vonage:setup": "node scripts/vonage-setup.mjs",
    "test:workflow": "tsx --test services/orchestrator/test/*.test.ts",
    "voice:smoke": "tsx scripts/voice-conversation-smoke.mts",
    "start": "node scripts/serve-production.mjs",
    "test:production": "node --test scripts/test/production-gateway.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/cors": "^2.8.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
