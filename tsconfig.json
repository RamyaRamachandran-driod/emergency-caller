{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "services/**/*.ts",
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx"
  ]
}
